<Project Sdk="Microsoft.NET.Sdk">

  <!-- What a plugin registry is made of, in code: keys and signatures, the statement a publisher signs, the
       documents, the checks an instance makes, the compiled index and its timestamp, and the manifest a hook plugin
       carries in its .stkmeta section. No YAML: a caller reads registry.yaml and hands the documents over as JSON. -->
  <PropertyGroup>
    <RootNamespace>Stoker.Plugins.Registry</RootNamespace>
    <AssemblyName>Stoker.Plugins.Registry</AssemblyName>
    <PackageId>StokerHQ.Plugins.Registry</PackageId>
    <Description>Stoker plugin registries: publisher and registry signatures, version statements, registry checks, the compiled index and its signed timestamp, and the manifest reader for hook plugins.</Description>
    <PackageTags>stoker;plugins;registry</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documented where the contract is not self-evident, as in Stoker; the XML file carries what is. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" />
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

</Project>
