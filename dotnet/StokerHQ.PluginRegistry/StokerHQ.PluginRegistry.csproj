<Project Sdk="Microsoft.NET.Sdk">

  <!-- What a plugin registry is made of, in code: keys and signatures, the statement a publisher signs, the
       documents, the checks an instance makes, the compiled index and its timestamp, and the manifest a hook plugin
       carries in its .stkmeta section. No YAML: a caller reads registry.yaml and hands the documents over as JSON. -->
  <PropertyGroup>
    <RootNamespace>StokerHQ.PluginRegistry</RootNamespace>
    <AssemblyName>StokerHQ.PluginRegistry</AssemblyName>
    <PackageId>StokerHQ.PluginRegistry</PackageId>
    <Description>Stoker plugin registries: publisher and registry signatures, version statements, registry checks, the compiled index and its signed timestamp, and the manifest reader for hook plugins.</Description>
    <PackageTags>stoker;plugins;registry</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documented where the contract is not self-evident, as in Stoker; the XML file carries what is. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies of StokerHQ/schemas' plugins/v1 version, plugin and registry schemas and the metadata/v1 common schema
         they refer to, at the paths they have there so their relative $refs hold. RegistrySchemas validates every
         document against them. Refresh them whenever those files change in StokerHQ/schemas. -->
    <EmbeddedResource Include="Schemas\**\*.schema.json" LogicalName="StokerHQ.PluginRegistry.Schemas/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
